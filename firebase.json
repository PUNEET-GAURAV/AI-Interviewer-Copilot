    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "Interview Mate",
        "supportEmail": "pvk2502@gmail.com"
      }
    }
  }
}
